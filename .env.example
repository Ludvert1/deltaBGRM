# ─────────────────────────────────────────────────────────────────────────────
# Delta AUS Bag Room Platform — environment
# Copy to .env.local for local development; set the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# Every value below is optional. With none of them set the platform still runs
# on free anonymous OpenSky + the FAA feed, in the degraded mode the console
# and every report explain in full.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenSky Network (free) ───────────────────────────────────────────────────
# Strongly recommended. Anonymous access gets 400 API credits per day, which a
# frequent poller plus a floor full of boards will exhaust before lunch. An
# OpenSky account with an API client raises it to 4,000/day.
#   1. Register at https://opensky-network.org
#   2. Account → API Clients → create a client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Poll arrivals as well as departures. Doubles credit usage; leave off until
# the OAuth2 credentials above are set.
POLL_ARRIVALS=0

# ── FlightAware AeroAPI (optional, paid beyond a small monthly credit) ───────
# The ONLY source that gives real scheduled times, gate assignments and true
# `cancelled` flags. Without it, cancellations are inferred from the learned
# schedule and labelled "Suspected Cancel". Personal tier includes a monthly
# usage credit: https://flightaware.com/aeroapi
AEROAPI_KEY=

# ── Durable storage (recommended) ────────────────────────────────────────────
# Without this the platform uses an in-memory store: the learned schedule and
# all report history reset whenever the serverless instance recycles.
# Attach Vercel KV (Marketplace → Upstash) and these are injected automatically,
# or paste an Upstash Redis REST URL and token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Endpoint protection ──────────────────────────────────────────────────────
# Protects /api/cron/* and /api/ingest. Vercel Cron sends it automatically as a
# Bearer token. Leave empty for a first deploy; set it before the URL is shared.
# NOTE: if you set this, the board's ops sync to /api/ingest will start failing
# unless you also proxy it — see "Protecting the endpoints" in the README.
CRON_SECRET=
